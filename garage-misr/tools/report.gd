## Writes reports/after.csv and reports/summary.md from the level files, and merges
## reports/before_*.csv into reports/before.csv.
## Usage: godot --headless -s tools/report.gd
extends SceneTree


func _init() -> void:
	var before := _merge_before()
	var rows := []
	for id in range(1, 121):
		var path := LevelLoader.path_for(id)
		if not FileAccess.file_exists(path):
			continue
		var lv := LevelLoader.load_file(path)
		var cfg := Campaign.config(id)
		var st: Dictionary = lv.get("stats", {})
		var b: Array = cfg["band"]
		var loss: float = st.get("random_loss", -1.0)
		rows.append({"id": id, "garage": cfg["garage_key"], "garage_name": lv["garage_name"],
			"item": lv["item_name"], "grid": "%dx%d" % [lv["w"], lv["h"]],
			"colors": lv["palette"].size(), "queues": lv["queues"].size(),
			"trailers": lv["solution"].size(), "extreme": lv["extreme"],
			"floor": lv.get("floor", 0.0), "trap": lv.get("trap", 0.0),
			"random_loss": loss, "smart_win": st.get("smart_win", -1.0),
			"band": "%d-%d" % [b[0], b[1]], "in_band": loss >= b[0] and loss <= b[1],
			"in_target": lv.get("in_target", false), "before": before.get(id, -1.0),
			"valid": LevelValidator.check(lv).is_empty()})
	var f := FileAccess.open("res://reports/after.csv", FileAccess.WRITE)
	f.store_line("level,garage,item,grid,colors,queues,trailers,extreme,floor,trap,random_loss_pct,smart_win_pct,band,in_band,in_target,valid")
	for r in rows:
		f.store_line("%d,%s,%s,%s,%d,%d,%d,%s,%.2f,%.3f,%.1f,%.1f,%s,%s,%s,%s" % [r["id"], r["garage"],
			r["item"], r["grid"], r["colors"], r["queues"], r["trailers"], r["extreme"], r["floor"],
			r["trap"], r["random_loss"], r["smart_win"], r["band"], r["in_band"], r["in_target"], r["valid"]])
	f.close()
	_summary(rows)
	print("wrote %d rows" % rows.size())
	quit()


func _merge_before() -> Dictionary:
	var out := {}
	var lines := []
	for name in DirAccess.get_files_at("res://reports"):
		if name.begins_with("before_") and name.ends_with(".csv"):
			for line in FileAccess.get_file_as_string("res://reports/" + name).split("\n", false):
				lines.append(line)
	if lines.is_empty():
		return out
	lines.sort_custom(func(a, b): return int(a.split(",")[0]) < int(b.split(",")[0]))
	var f := FileAccess.open("res://reports/before.csv", FileAccess.WRITE)
	f.store_line("level,garage,item,random_loss_pct,smart_win_pct")
	for line in lines:
		f.store_line(line)
		out[int(line.split(",")[0])] = float(line.split(",")[3])
	f.close()
	return out


func _summary(rows: Array) -> void:
	var md := "# Level report\n\nGenerated by tools/report.gd from levels/*.json. RandomBot loss and SmartBot win " \
		+ "are measured over 200 games each on the real engine.\n\n"
	md += "## Per garage\n\n| Garage | Levels | Band | Before: RandomBot loss (avg) | After: RandomBot loss (avg) | SmartBot win (min) | In band |\n|---|---|---|---|---|---|---|\n"
	var by_garage := {}
	for r in rows:
		if not by_garage.has(r["garage"]):
			by_garage[r["garage"]] = []
		by_garage[r["garage"]].append(r)
	for g in by_garage:
		var rs: Array = by_garage[g]
		var normal := rs.filter(func(r): return not r["extreme"])
		var avg := func(arr, key): return arr.reduce(func(a, r): return a + r[key], 0.0) / maxf(1, arr.size())
		var bands := {}
		for r in normal:
			bands[r["band"]] = true
		md += "| %s | %d-%d | %s%% | %.1f%% | %.1f%% | %.1f%% | %d/%d |\n" % [rs[0]["garage_name"],
			rs[0]["id"], rs[-1]["id"], "، ".join(bands.keys()), avg.call(rs, "before"),
			avg.call(normal, "random_loss"), rs.reduce(func(a, r): return minf(a, r["smart_win"]), 100.0),
			rs.filter(func(r): return r["in_band"]).size(), rs.size()]
	md += "\nExtreme levels (جراج المعلم, band 75-85%) are excluded from the After average and listed below.\n"
	md += "\n## All levels\n\n| # | Garage | Item | Grid | Colors | Queues | Trailers | Before | RandomBot loss | SmartBot win | Band | In band | Target |\n|---|---|---|---|---|---|---|---|---|---|---|---|---|\n"
	for r in rows:
		md += "| %d%s | %s | %s | %s | %d | %d | %d | %.1f%% | %.1f%% | %.1f%% | %s | %s | %s |\n" % [r["id"],
			" ★" if r["extreme"] else "", r["garage_name"], r["item"], r["grid"], r["colors"], r["queues"],
			r["trailers"], r["before"], r["random_loss"], r["smart_win"], r["band"],
			"✓" if r["in_band"] else "✗", "✓" if r["in_target"] else "–"]
	var f := FileAccess.open("res://reports/summary.md", FileAccess.WRITE)
	f.store_string(md)
	f.close()
